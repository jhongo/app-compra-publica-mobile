<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

            <!-- Título centrado en dos líneas -->
            <Label Text="COMPRA PÚBLICA&#10;CERCA"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

            <!-- Campo Usuario -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Usuario" FontSize="14" FontAttributes="Bold" />
                <Entry Placeholder="Ingrese usuario"
                       Text="{Binding Username}" />
            </VerticalStackLayout>

            <!-- Campo Contraseña -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Contraseña" FontSize="14" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*, Auto">
                    <Entry Grid.Column="0"
                           Placeholder="Ingrese contraseña"
                           IsPassword="{Binding IsPasswordHidden}"
                           Text="{Binding Password}" />
                    <Button Grid.Column="1"
                            Text="👁"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                            Command="{Binding TogglePasswordVisibilityCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Enlace Recuperar contraseña alineado a la derecha -->
            <!-- TODO: conectar cuando exista la recuperación de contraseña. -->
            <Label Text="Recuperar contraseña"
                   HorizontalOptions="End"
                   TextColor="{StaticResource PrimaryColor}"
                   TextDecorations="Underline" />

            <!-- Botón principal Ingresar -->
            <!-- TODO: conectar cuando exista el login con usuario y contraseña. -->
            <Button Text="Ingresar"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="{StaticResource White}"
                    CornerRadius="8" />

            <!-- Separador horizontal con la letra "O" al centro -->
            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                <BoxView Grid.Column="0" HeightRequest="1" Color="{StaticResource SeparatorColor}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="O" FontSize="14" TextColor="{StaticResource SeparatorColor}" FontAttributes="Bold" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource SeparatorColor}" VerticalOptions="Center" />
            </Grid>

            <!-- Botón Iniciar Sesión con Google -->
            <Button Text="Iniciar Sesión con Google"
                    BackgroundColor="{StaticResource GoogleButtonColor}"
                    TextColor="{StaticResource White}"
                    CornerRadius="8"
                    Command="{Binding SignInWithGoogleCommand}">
                <Button.ImageSource>
                    <FontImageSource Glyph="G" Color="White" Size="18" />
                </Button.ImageSource>
            </Button>

            <!-- Texto "¿No tienes una cuenta?" + enlace "Regístrate" -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="¿No tienes una cuenta?" />
                <Label Text="Regístrate"
                       TextColor="{StaticResource PrimaryColor}"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Estado del inicio de sesión -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center"
                                   Color="{StaticResource PrimaryColor}" />
                <Label Text="{Binding StatusMessage}"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource PrimaryColor}"
                       FontSize="13" />
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}"
                       HorizontalTextAlignment="Center"
                       FontSize="13" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
