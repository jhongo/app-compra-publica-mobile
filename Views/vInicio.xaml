<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CompraPublicCercaMobile.Models"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.vInicio"
             x:DataType="viewModels:HomeViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="SubtitleColor">#5F6B7A</Color>
        <Color x:Key="InputFillColor">#EEF0F3</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="16">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Title}"
                       FontSize="24"
                       FontAttributes="Bold" />
                <Label Text="Compra Pública Cerca"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="{StaticResource SeparatorColor}" />

            <!-- Saludo y ubicación -->
            <VerticalStackLayout Spacing="2" Margin="0,4,0,0">
                <Label Text="{Binding Greeting}"
                       FontSize="22"
                       FontAttributes="Bold" />
                <Label Text="{Binding Location, StringFormat='Ubicación: {0}'}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <!-- Búsqueda -->
            <Border Stroke="{StaticResource SeparatorColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <Entry Placeholder="¿Qué oportunidad buscas?"
                       Text="{Binding SearchText}"
                       ReturnType="Search"
                       ReturnCommand="{Binding SearchCommand}"
                       HeightRequest="48" />
            </Border>

            <!-- Búsqueda sugerida: al tocarla se copia al campo de búsqueda -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,0"
                    HeightRequest="48"
                    BackgroundColor="{AppThemeBinding Light={StaticResource InputFillColor}, Dark={StaticResource Gray600}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding UseSuggestedSearchCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding SuggestedSearch}"
                       VerticalOptions="Center" />
            </Border>

            <Button Text="BUSCAR"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Command="{Binding SearchCommand}" />

            <!-- Oportunidades recomendadas -->
            <Label Text="Oportunidades recomendadas"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,16,0,0" />

            <VerticalStackLayout Spacing="12"
                                 BindableLayout.ItemsSource="{Binding RecommendedOpportunities}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Opportunity">
                        <Border Stroke="{StaticResource SeparatorColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="12"
                                  ColumnSpacing="12">

                                <Label Grid.ColumnSpan="2"
                                       Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold" />

                                <VerticalStackLayout Grid.Row="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding MatchPercentage, StringFormat='Coincidencia: {0}%'}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
                                    <Label Text="{Binding Deadline, StringFormat='Fecha límite: {0:dd/MM/yyyy}'}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
                                </VerticalStackLayout>

                                <!-- TODO: navegar al detalle cuando exista la pantalla. -->
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Text="DETALLE"
                                        FontSize="13"
                                        Padding="16,0"
                                        HeightRequest="40"
                                        VerticalOptions="Center"
                                        CornerRadius="8"
                                        BorderWidth="1"
                                        BorderColor="{StaticResource PrimaryColor}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource PrimaryColor}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
