<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CompraPublicCercaMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:constants="clr-namespace:CompraPublicCercaMobile.Constants"
    xmlns:views="clr-namespace:CompraPublicCercaMobile.Views"
    Title="CompraPublicCercaMobile"
    Shell.FlyoutBehavior="Disabled">

    <!-- La primera ruta es la pantalla inicial. -->
    <ShellContent
        Title="Iniciar sesión"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="{x:Static constants:NavigationRoutes.Login}" />

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate views:vInicio}"
        Route="{x:Static constants:NavigationRoutes.Inicio}" />

</Shell>
