<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="Iniciar sesión">
    <VerticalStackLayout Padding="24"
                         Spacing="16"
                         VerticalOptions="Center">
        <Label Text="Compra Pública Cerca"
               Style="{StaticResource Headline}" />

        <Button Text="Iniciar sesión con Google"
                Command="{Binding SignInWithGoogleCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}" />

        <Label Text="{Binding StatusMessage}"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
