<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CompraPublicCercaMobile.Controls"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource BrandBackground}, Dark={StaticResource BrandInk}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,32"
                             Spacing="0"
                             VerticalOptions="Center">

            <!-- ===== Marca ===== -->
            <Image Source="{AppThemeBinding Light=brand_isotipo_azul.png, Dark=brand_isotipo_crema.png}"
                   WidthRequest="64"
                   HeightRequest="64"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Logotipo de Compra Pública" />

            <Label Text="COMPRA PÚBLICA CERCA"
                   Margin="0,12,0,0"
                   FontFamily="OpenSansSemibold"
                   FontSize="13"
                   CharacterSpacing="1.4"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandCream}}" />

            <!-- ===== Encabezado ===== -->
            <Label Text="¡Bienvenido!"
                   Margin="0,40,0,0"
                   FontFamily="OpenSansSemibold"
                   FontSize="28"
                   SemanticProperties.HeadingLevel="Level1"
                   TextColor="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}" />

            <Label Text="Inicia sesión para encontrar concursos públicos cerca de ti."
                   Margin="0,6,0,0"
                   FontSize="15"
                   LineHeight="1.2"
                   TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandTertiary}}" />

            <!-- ===== Correo ===== -->
            <Border Margin="0,32,0,0"
                    Style="{StaticResource AuthFieldBorderStyle}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 x:DataType="controls:BorderlessEntry"
                                 Binding="{Binding Source={x:Reference UsernameEntry}, Path=IsFocused}"
                                 Value="True">
                        <Setter Property="Stroke" Value="{StaticResource BrandSecondary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="ic_field_mail.png"
                           Style="{StaticResource AuthFieldIconStyle}" />
                    <controls:BorderlessEntry x:Name="UsernameEntry"
                                              Grid.Column="1"
                                              Placeholder="Correo electrónico"
                                              Text="{Binding Email}"
                                              Keyboard="Email"
                                              IsSpellCheckEnabled="False"
                                              IsTextPredictionEnabled="False"
                                              ReturnType="Next"
                                              Style="{StaticResource AuthEntryStyle}"
                                              SemanticProperties.Description="Correo electrónico" />
                </Grid>
            </Border>
            <Label Text="{Binding EmailError}" Style="{StaticResource FieldErrorStyle}" />

            <!-- ===== Contraseña ===== -->
            <Border Margin="0,14,0,0"
                    Style="{StaticResource AuthFieldBorderStyle}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 x:DataType="controls:BorderlessEntry"
                                 Binding="{Binding Source={x:Reference PasswordEntry}, Path=IsFocused}"
                                 Value="True">
                        <Setter Property="Stroke" Value="{StaticResource BrandSecondary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Image Source="ic_field_lock.png"
                           Style="{StaticResource AuthFieldIconStyle}" />
                    <controls:BorderlessEntry x:Name="PasswordEntry"
                                              Grid.Column="1"
                                              Placeholder="Contraseña"
                                              Text="{Binding Password}"
                                              IsPassword="{Binding IsPasswordHidden}"
                                              IsSpellCheckEnabled="False"
                                              IsTextPredictionEnabled="False"
                                              ReturnType="Go"
                                              ReturnCommand="{Binding LoginCommand}"
                                              Style="{StaticResource AuthEntryStyle}"
                                              SemanticProperties.Description="Contraseña" />

                    <!-- Mostrar / ocultar contraseña: área táctil de 44x44 -->
                    <ImageButton Grid.Column="2"
                                 Source="ic_eye.png"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Padding="11"
                                 BackgroundColor="Transparent"
                                 VerticalOptions="Center"
                                 Command="{Binding TogglePasswordVisibilityCommand}"
                                 SemanticProperties.Description="Mostrar contraseña">
                        <ImageButton.Triggers>
                            <DataTrigger TargetType="ImageButton"
                                         Binding="{Binding IsPasswordHidden}"
                                         Value="False">
                                <Setter Property="Source" Value="ic_eye_off.png" />
                                <Setter Property="SemanticProperties.Description" Value="Ocultar contraseña" />
                            </DataTrigger>
                        </ImageButton.Triggers>
                    </ImageButton>
                </Grid>
            </Border>
            <Label Text="{Binding PasswordError}" Style="{StaticResource FieldErrorStyle}" />

            <!-- Padding: área táctil cómoda sin agrandar el texto -->
            <Label Text="¿Olvidaste tu contraseña?"
                   Margin="0,0,0,0"
                   Padding="8,8,0,8"
                   HorizontalOptions="End"
                   FontSize="13"
                   Style="{StaticResource AuthLinkStyle}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToForgotPasswordCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- ===== Acciones ===== -->
            <Button Text="Ingresar"
                    Margin="0,16,0,0"
                    Style="{StaticResource AuthPrimaryButtonStyle}"
                    Command="{Binding LoginCommand}" />

            <!-- Inicio rápido: solo si se activó en Perfil y hay una sesión guardada -->
            <VerticalStackLayout Margin="0,12,0,0" Spacing="4" IsVisible="{Binding CanUseBiometrics}">
                <Button Text="{Binding BiometricButtonText}"
                        HeightRequest="54"
                        Style="{StaticResource TonalButtonStyle}"
                        Command="{Binding LoginWithBiometricsCommand}" />
                <Label Text="{Binding BiometricAccountText}"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandTertiary}}" />
            </VerticalStackLayout>

            <!-- Separador -->
            <Grid ColumnDefinitions="*,Auto,*"
                  ColumnSpacing="12"
                  Margin="24,32,24,20">
                <BoxView Grid.Column="0"
                         HeightRequest="1"
                         VerticalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource BrandFieldBorder}, Dark={StaticResource BrandPrimary}}" />
                <Label Grid.Column="1"
                       Text="o continúa con"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandTertiary}}" />
                <BoxView Grid.Column="2"
                         HeightRequest="1"
                         VerticalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource BrandFieldBorder}, Dark={StaticResource BrandPrimary}}" />
            </Grid>

            <!-- Inicio de sesión social -->
            <ImageButton Source="google_icon.png"
                         HorizontalOptions="Center"
                         Style="{StaticResource AuthSocialButtonStyle}"
                         Command="{Binding SignInWithGoogleCommand}"
                         SemanticProperties.Description="Continuar con Google" />

            <!-- Estado justo bajo el último botón tocado, para que el error se vea sin desplazarse -->
            <ActivityIndicator Margin="0,12,0,0"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandCream}}" />

            <Label Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandTertiary}}" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   Margin="0,8,0,0"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />


            <!-- Registro -->
            <HorizontalStackLayout Margin="0,28,0,0"
                                   HorizontalOptions="Center"
                                   Spacing="4">
                <Label Text="¿No tienes una cuenta?"
                       FontSize="14"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandTertiary}}" />
                <Label Text="Regístrate"
                       Style="{StaticResource AuthLinkStyle}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
