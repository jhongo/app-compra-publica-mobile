<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CompraPublicCercaMobile.Views.Components"
             xmlns:controls="clr-namespace:CompraPublicCercaMobile.Controls"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.SearchPage"
             x:DataType="viewModels:SearchViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource BrandBackground}, Dark={StaticResource BrandInk}}">

    <ContentPage.Resources>
        <!-- Título de cada filtro -->
        <Style x:Key="FilterLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}" />
        </Style>

    </ContentPage.Resources>

    <ScrollView>
        <!-- Margen inferior amplio: la barra de pestañas de iOS 26 flota sobre el contenido. -->
        <VerticalStackLayout Padding="24,16,24,120" Spacing="0">

            <!-- ===== Encabezado ===== -->
            <Label Text="Buscar procesos"
                   FontFamily="OpenSansSemibold"
                   FontSize="26"
                   SemanticProperties.HeadingLevel="Level1"
                   TextColor="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}" />
            <Label Text="Filtra los concursos publicados en SERCOP."
                   Margin="0,4,0,0"
                   Style="{StaticResource SecondaryTextStyle}"
                   FontSize="14" />

            <!-- ===== Palabra clave (obligatoria) ===== -->
            <Border Margin="0,20,0,0" Style="{StaticResource AuthFieldBorderStyle}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" x:DataType="controls:BorderlessEntry"
                                 Binding="{Binding Source={x:Reference KeywordEntry}, Path=IsFocused}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource BrandSecondary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="ic_field_search.png" Style="{StaticResource AuthFieldIconStyle}" />
                    <controls:BorderlessEntry x:Name="KeywordEntry"
                                              Grid.Column="1"
                                              Placeholder="¿Qué buscas? p. ej. limpieza"
                                              Text="{Binding Keyword}"
                                              ReturnType="Search"
                                              ReturnCommand="{Binding SearchCommand}"
                                              Style="{StaticResource AuthEntryStyle}"
                                              SemanticProperties.Description="Palabra clave, obligatoria" />
                </Grid>
            </Border>

            <!-- Sugerencias (la API no tiene filtro de categoría) -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-24,12,-24,0">
                <HorizontalStackLayout Padding="24,0" Spacing="8" BindableLayout.ItemsSource="{Binding KeywordSuggestions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{StaticResource ChipBorderStyle}" MinimumHeightRequest="36">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding UseSuggestionCommand, Source={RelativeSource AncestorType={x:Type viewModels:SearchViewModel}}, x:DataType=viewModels:SearchViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}" Style="{StaticResource ChipLabelStyle}" FontFamily="OpenSansRegular" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ===== Filtros (plegable, sin tarjeta contenedora) ===== -->
            <VerticalStackLayout Margin="0,24,0,0">

                    <!-- Cabecera: al tocar se muestran u ocultan los filtros -->
                    <Grid ColumnDefinitions="*,Auto"
                          MinimumHeightRequest="44"
                          SemanticProperties.Description="Filtros"
                          SemanticProperties.Hint="Toca para mostrar u ocultar los filtros">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFiltersCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Filtros"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}" />
                            <Label Text="{Binding FiltersSummary}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1"
                               Source="ic_chevron_down.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               VerticalOptions="Center">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsFiltersExpanded}" Value="True">
                                    <Setter Property="Rotation" Value="180" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsFiltersExpanded}">

                        <!-- Año -->
                        <Label Text="Año" Style="{StaticResource FilterLabelStyle}" />
                        <Border Padding="16,0,12,0" Style="{StaticResource AuthFieldBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Image Source="ic_field_calendar.png" Style="{StaticResource AuthFieldIconStyle}" />
                                <controls:BorderlessPicker Grid.Column="1"
                                                           Title="Año"
                                                           ItemsSource="{Binding Years}"
                                                           SelectedItem="{Binding SelectedYear}"
                                                           FontSize="15"
                                                           MinimumHeightRequest="54"
                                                           VerticalOptions="Center"
                                                           BackgroundColor="Transparent"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}"
                                                           SemanticProperties.Description="Año del proceso" />
                                <Image Grid.Column="2" Source="ic_chevron_down.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Border>

                        <!-- Tipo de procedimiento -->
                        <Label Text="Tipo de procedimiento" Style="{StaticResource FilterLabelStyle}" />
                        <!-- Control segmentado: una pista tonal y el segmento elegido en superficie -->
                        <Border Padding="4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandFieldFill}, Dark={StaticResource BrandFieldFillDark}}">
                            <FlexLayout Direction="Row" BindableLayout.ItemsSource="{Binding MethodOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:FilterOptionViewModel">
                                        <Border FlexLayout.Grow="1"
                                                FlexLayout.Basis="0"
                                                HeightRequest="40"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="Transparent"
                                                SemanticProperties.Description="{Binding Label, StringFormat='Tipo: {0}'}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding SelectMethodCommand, Source={RelativeSource AncestorType={x:Type viewModels:SearchViewModel}}, x:DataType=viewModels:SearchViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandSecondary}}" />
                                                    <Setter Property="Shadow">
                                                        <Shadow Brush="{StaticResource BrandPrimary}" Opacity="0.10" Radius="6" Offset="0,2" />
                                                    </Setter>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Label}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="13"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandTertiary}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Border>
                        <Label Text="{Binding MethodDescription}" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" />

                        <!-- Provincia (filtro local) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Provincia" Style="{StaticResource FilterLabelStyle}" />
                            <Label Grid.Column="1"
                                   Text="{Binding UseMyProvinceText}"
                                   IsVisible="{Binding HasUserProvince}"
                                   Margin="0,16,0,8"
                                   Style="{StaticResource AuthLinkStyle}"
                                   FontSize="13"
                                   MinimumHeightRequest="0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UseMyProvinceCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Border Padding="16,0,12,0" Style="{StaticResource AuthFieldBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Image Source="ic_field_place.png" Style="{StaticResource AuthFieldIconStyle}" />
                                <controls:BorderlessPicker Grid.Column="1"
                                                           Title="Provincia"
                                                           ItemsSource="{Binding Provinces}"
                                                           SelectedItem="{Binding SelectedProvince}"
                                                           FontSize="15"
                                                           MinimumHeightRequest="54"
                                                           VerticalOptions="Center"
                                                           BackgroundColor="Transparent"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}"
                                                           SemanticProperties.Description="Provincia" />
                                <Image Grid.Column="2" Source="ic_chevron_down.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Border>

                        <!-- Monto (filtro local) -->
                        <Label Text="Monto" Style="{StaticResource FilterLabelStyle}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding AmountOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:FilterOptionViewModel">
                                    <Border Style="{StaticResource ChipBorderStyle}"
                                            Margin="0,0,8,8"
                                            SemanticProperties.Description="{Binding Label, StringFormat='Monto: {0}'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectAmountCommand, Source={RelativeSource AncestorType={x:Type viewModels:SearchViewModel}}, x:DataType=viewModels:SearchViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandCream}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Label}" Style="{StaticResource ChipLabelStyle}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandInk}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Entidad contratante -->
                        <Label Text="Entidad contratante (opcional)" Style="{StaticResource FilterLabelStyle}" />
                        <Border Style="{StaticResource AuthFieldBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Image Source="ic_building.png" Style="{StaticResource AuthFieldIconStyle}" />
                                <controls:BorderlessEntry Grid.Column="1"
                                                          Placeholder="p. ej. Municipio de Quito"
                                                          Text="{Binding Buyer}"
                                                          ReturnType="Next"
                                                          Style="{StaticResource AuthEntryStyle}"
                                                          SemanticProperties.Description="Entidad contratante, opcional" />
                            </Grid>
                        </Border>

                        <!-- Proveedor -->
                        <Label Text="Proveedor (opcional)" Style="{StaticResource FilterLabelStyle}" />
                        <Border Style="{StaticResource AuthFieldBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Image Source="ic_field_person.png" Style="{StaticResource AuthFieldIconStyle}" />
                                <controls:BorderlessEntry Grid.Column="1"
                                                          Placeholder="Nombre o razón social"
                                                          Text="{Binding Supplier}"
                                                          ReturnType="Search"
                                                          ReturnCommand="{Binding SearchCommand}"
                                                          Style="{StaticResource AuthEntryStyle}"
                                                          SemanticProperties.Description="Proveedor, opcional" />
                            </Grid>
                        </Border>

                        <Label Text="Provincia y monto los aplica la app sobre los resultados de SERCOP, porque la API no tiene esos filtros."
                               Margin="0,12,0,0"
                               FontSize="12"
                               TextColor="{StaticResource BrandTertiary}" />

                        <Label Text="Limpiar filtros"
                               Margin="0,4,0,0"
                               HorizontalOptions="Start"
                               Style="{StaticResource AuthLinkStyle}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Validación -->
            <Label Text="{Binding ValidationMessage}"
                   Margin="0,12,0,0"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button Text="Buscar"
                    Margin="0,16,0,0"
                    Style="{StaticResource AuthPrimaryButtonStyle}"
                    Command="{Binding SearchCommand}" />

            <!-- ===== Resultados ===== -->
            <VerticalStackLayout Margin="0,32,0,12" Spacing="4" IsVisible="{Binding HasResults}">
                <Label Text="Resultados" Style="{StaticResource SectionTitleStyle}" />
                <Label Text="{Binding ResultsSummary}" Style="{StaticResource SecondaryTextStyle}" />
                <Label Text="{Binding LocalFilterNote}"
                       FontSize="12"
                       TextColor="{StaticResource BrandTertiary}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding LocalFilterNote}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <ActivityIndicator Margin="0,32"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandCream}}" />

            <!-- Error -->
            <Border Margin="0,24,0,0" Padding="24" IsVisible="{Binding HasError}" Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Image Source="ic_cloud_off.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource SecondaryTextStyle}" HorizontalTextAlignment="Center" />
                    <Button Text="Reintentar" Margin="0,8,0,0" Padding="32,0" HorizontalOptions="Center"
                            Style="{StaticResource TonalButtonStyle}" Command="{Binding SearchCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Sin resultados -->
            <VerticalStackLayout Margin="0,24,0,0" Spacing="8" IsVisible="{Binding IsEmpty}">
                <Image Source="ic_field_search.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                <Label Text="No encontramos procesos con esos filtros"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}" />
                <Label Text="Prueba con otra palabra, otro año o quita algún filtro."
                       Style="{StaticResource SecondaryTextStyle}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding LocalFilterNote}"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource BrandTertiary}" />
            </VerticalStackLayout>

            <!-- Lista -->
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Results}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:OpportunityItemViewModel">
                        <components:OpportunityCard
                            TapCommand="{Binding OpenDetailCommand, Source={RelativeSource AncestorType={x:Type viewModels:SearchViewModel}}, x:DataType=viewModels:SearchViewModel}"
                            FavoriteCommand="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type viewModels:SearchViewModel}}, x:DataType=viewModels:SearchViewModel}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Ver más resultados"
                    Margin="0,16,0,0"
                    Style="{StaticResource TonalButtonStyle}"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding HasMorePages}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsLoadingMore}" Value="True">
                        <Setter Property="Text" Value="Cargando…" />
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Label Text="Datos abiertos de SERCOP (estándar OCDS) · Licencia CC BY 3.0 EC"
                   Margin="0,24,0,0"
                   FontSize="11"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource BrandTertiary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
