<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.SearchPage"
             x:DataType="viewModels:SearchViewModel"
             Title="Buscar"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All">

    <ContentPage.Resources>
        <Color x:Key="SearchSubtitleColor">#5F6B7A</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24"
                             Spacing="16">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Buscar oportunidades"
                       FontSize="24"
                       FontAttributes="Bold" />

                <Label Text="Compra Pública Cerca"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource SearchSubtitleColor}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="{StaticResource SeparatorColor}" />

            <!-- Campo de búsqueda -->
            <Label Text="Palabra clave"
                   FontSize="15"
                   FontAttributes="Bold" />

            <Border Stroke="{StaticResource SeparatorColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                <Entry Placeholder="¿Qué oportunidad buscas?"
                       Text="{Binding SearchText}"
                       HeightRequest="48"
                       ReturnType="Search" />

            </Border>

            <!-- Sección de filtros -->
            <Label Text="Filtros de búsqueda"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,8,0,0" />

            <!-- Provincia o ciudad -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Provincia o ciudad"
                       FontSize="14" />

                <Border Stroke="{StaticResource SeparatorColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                    <Picker Title="Seleccionar ubicación"
                            SelectedItem="{Binding SelectedLocation}"
                            HeightRequest="48">
                        <Picker.Items>
                            <x:String>Todas</x:String>
                            <x:String>Pichincha</x:String>
                            <x:String>Guayas</x:String>
                            <x:String>Azuay</x:String>
                            <x:String>Quito</x:String>
                            <x:String>Guayaquil</x:String>
                            <x:String>Cuenca</x:String>
                        </Picker.Items>
                    </Picker>

                </Border>
            </VerticalStackLayout>

            <!-- Tipo de proceso -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Tipo de proceso"
                       FontSize="14" />

                <Border Stroke="{StaticResource SeparatorColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                    <Picker Title="Seleccionar tipo"
                            SelectedItem="{Binding SelectedProcessType}"
                            HeightRequest="48">
                        <Picker.Items>
                            <x:String>Todos</x:String>
                            <x:String>Ínfima cuantía</x:String>
                            <x:String>Subasta inversa</x:String>
                            <x:String>Catálogo electrónico</x:String>
                            <x:String>Licitación</x:String>
                        </Picker.Items>
                    </Picker>

                </Border>
            </VerticalStackLayout>

            <!-- Monto -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Monto"
                       FontSize="14" />

                <Border Stroke="{StaticResource SeparatorColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                    <Picker Title="Seleccionar rango de monto"
                            SelectedItem="{Binding SelectedAmount}"
                            HeightRequest="48">
                        <Picker.Items>
                            <x:String>Todos los montos</x:String>
                            <x:String>Hasta $5.000</x:String>
                            <x:String>De $5.001 a $10.000</x:String>
                            <x:String>De $10.001 a $50.000</x:String>
                            <x:String>Más de $50.000</x:String>
                        </Picker.Items>
                    </Picker>

                </Border>
            </VerticalStackLayout>

            <!-- Botón visual de búsqueda -->
            <Button Text="BUSCAR"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Margin="0,8,0,0" />

            <!-- Encabezado de resultados -->
            <Label Text="Resultados de búsqueda"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,12,0,0" />

            <!-- Tarjetas con datos de ejemplo -->
            <VerticalStackLayout Spacing="12"
                                 BindableLayout.ItemsSource="{Binding Results}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SearchResultItem">

                        <Border Stroke="{StaticResource SeparatorColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                            <VerticalStackLayout Spacing="10">

                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding Entity, StringFormat='Entidad: {0}'}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource SearchSubtitleColor}, Dark={StaticResource Gray300}}" />

                                <Label Text="{Binding Amount, StringFormat='Monto: {0}'}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource SearchSubtitleColor}, Dark={StaticResource Gray300}}" />

                                <Label Text="{Binding Deadline, StringFormat='Fecha límite: {0:dd/MM/yyyy}'}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource SearchSubtitleColor}, Dark={StaticResource Gray300}}" />

                                <!-- Botón visual, sin navegación -->
                                <Button Text="DETALLE"
                                        FontSize="13"
                                        Padding="16,0"
                                        HeightRequest="40"
                                        HorizontalOptions="End"
                                        CornerRadius="8"
                                        BorderWidth="1"
                                        BorderColor="{StaticResource PrimaryColor}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource PrimaryColor}" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <!-- Mensaje cuando no existen resultados -->
            <Label Text="No se encontraron resultados"
                   IsVisible="{Binding HasNoResults}"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SearchSubtitleColor}, Dark={StaticResource Gray300}}"
                   Margin="0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
