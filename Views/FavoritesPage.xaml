<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CompraPublicCercaMobile.Models"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.FavoritesPage"
             x:DataType="viewModels:FavoritesViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Mismos colores que la pantalla de Inicio. -->
        <Color x:Key="SubtitleColor">#5F6B7A</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          Padding="24,40,24,0">

        <!-- Encabezado -->
        <VerticalStackLayout Spacing="2">
            <Label Text="{Binding Title}"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="Procesos que guardaste"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
            <BoxView HeightRequest="1"
                     Margin="0,14,0,0"
                     Color="{StaticResource SeparatorColor}" />
        </VerticalStackLayout>

        <!-- Lista de favoritos. EmptyView se muestra solo cuando la lista queda vacía. -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Favorites}"
                        SelectionMode="None"
                        Margin="0,16,0,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,48"
                                     Spacing="8"
                                     HorizontalOptions="Center">
                    <Label Text="☆"
                           FontSize="40"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    <Label Text="Aún no tienes favoritos"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Guarda procesos desde Inicio o Buscar para verlos aquí."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Opportunity">
                    <!-- Misma tarjeta que en Inicio, con el botón para quitar de favoritos. -->
                    <Border Stroke="{StaticResource SeparatorColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="12"
                              ColumnSpacing="12">

                            <Label Text="{Binding Title}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="★"
                                    FontSize="22"
                                    Padding="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    VerticalOptions="Start"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource PrimaryColor}"
                                    SemanticProperties.Description="Quitar de favoritos"
                                    ToolTipProperties.Text="Quitar de favoritos"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:FavoritesViewModel}}, Path=RemoveFavoriteCommand, x:DataType=viewModels:FavoritesViewModel}"
                                    CommandParameter="{Binding .}" />

                            <VerticalStackLayout Grid.Row="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding MatchPercentage, StringFormat='Coincidencia: {0}%'}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding Deadline, StringFormat='Fecha límite: {0:dd/MM/yyyy}'}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource SubtitleColor}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>

                            <!-- TODO: navegar al detalle cuando exista la pantalla (issue #16). -->
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Text="DETALLE"
                                    FontSize="13"
                                    Padding="16,0"
                                    HeightRequest="40"
                                    VerticalOptions="Center"
                                    CornerRadius="8"
                                    BorderWidth="1"
                                    BorderColor="{StaticResource PrimaryColor}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource PrimaryColor}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Espacio al final para que la última tarjeta no quede pegada a la barra inferior. -->
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
