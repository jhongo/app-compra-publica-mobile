<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CompraPublicCercaMobile.Controls"
             xmlns:viewModels="clr-namespace:CompraPublicCercaMobile.ViewModels"
             x:Class="CompraPublicCercaMobile.Views.ForgotPasswordPage"
             x:DataType="viewModels:ForgotPasswordViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource BrandBackground}, Dark={StaticResource BrandInk}}">

    <!-- Tres pasos en la misma pantalla (correo → código → contraseña nueva): solo se muestra
         el campo del paso actual, así la tarea se lee de un vistazo. Mismos estilos que Login. -->
    <ScrollView>
        <VerticalStackLayout Padding="24,8,24,32" Spacing="0">

            <!-- ===== Volver ===== -->
            <ImageButton Source="{AppThemeBinding Light=ic_back_dark.png, Dark=ic_back_light.png}"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Margin="-10,0,0,0"
                         HorizontalOptions="Start"
                         BackgroundColor="Transparent"
                         Command="{Binding GoBackCommand}"
                         SemanticProperties.Description="Volver" />

            <!-- ===== Encabezado ===== -->
            <Label Text="Recupera tu contraseña"
                   Margin="0,16,0,0"
                   FontFamily="OpenSansSemibold"
                   FontSize="28"
                   SemanticProperties.HeadingLevel="Level1"
                   TextColor="{AppThemeBinding Light={StaticResource BrandInk}, Dark={StaticResource BrandCream}}" />

            <Label Text="{Binding Subtitle}"
                   Margin="0,6,0,0"
                   FontSize="15"
                   LineHeight="1.2"
                   TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandTertiary}}" />

            <!-- ===== Paso 1: correo ===== -->
            <VerticalStackLayout Margin="0,28,0,0" Spacing="0" IsVisible="{Binding IsEmailStep}">
                <Border Style="{StaticResource AuthFieldBorderStyle}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" x:DataType="controls:BorderlessEntry"
                                     Binding="{Binding Source={x:Reference EmailEntry}, Path=IsFocused}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource BrandSecondary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Source="ic_field_mail.png" Style="{StaticResource AuthFieldIconStyle}" />
                        <controls:BorderlessEntry x:Name="EmailEntry"
                                                  Grid.Column="1"
                                                  Placeholder="Correo electrónico"
                                                  Text="{Binding Email}"
                                                  Keyboard="Email"
                                                  IsSpellCheckEnabled="False"
                                                  IsTextPredictionEnabled="False"
                                                  ReturnType="Send"
                                                  ReturnCommand="{Binding SendCodeCommand}"
                                                  Style="{StaticResource AuthEntryStyle}"
                                                  SemanticProperties.Description="Correo electrónico" />
                    </Grid>
                </Border>
                <Label Text="{Binding EmailError}" Style="{StaticResource FieldErrorStyle}" />

                <Button Text="Enviar código"
                        Margin="0,20,0,0"
                        Style="{StaticResource AuthPrimaryButtonStyle}"
                        Command="{Binding SendCodeCommand}" />
            </VerticalStackLayout>

            <!-- ===== Paso 2: código ===== -->
            <VerticalStackLayout Margin="0,28,0,0" Spacing="0" IsVisible="{Binding IsCodeStep}">
                <Border Style="{StaticResource AuthFieldBorderStyle}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" x:DataType="controls:BorderlessEntry"
                                     Binding="{Binding Source={x:Reference CodeEntry}, Path=IsFocused}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource BrandSecondary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="ic_field_shield.png" Style="{StaticResource AuthFieldIconStyle}" />
                        <controls:BorderlessEntry x:Name="CodeEntry"
                                                  Grid.Column="1"
                                                  Placeholder="Código de 6 dígitos"
                                                  Text="{Binding Code}"
                                                  Keyboard="Numeric"
                                                  MaxLength="6"
                                                  Style="{StaticResource AuthEntryStyle}"
                                                  SemanticProperties.Description="Código de 6 dígitos" />
                        <ActivityIndicator Grid.Column="2"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           Margin="0,0,12,0"
                                           IsRunning="{Binding IsVerifyingCode}"
                                           IsVisible="{Binding IsVerifyingCode}"
                                           Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandCream}}" />
                    </Grid>
                </Border>
                <Label Text="{Binding CodeError}" Style="{StaticResource FieldErrorStyle}" />

                <!-- Acciones secundarias como enlaces: el paso avanza solo al completar el código -->
                <Grid ColumnDefinitions="*,*" Margin="0,14,0,0">
                    <Label Text="{Binding ResendText}"
                           Style="{StaticResource AuthLinkStyle}"
                           FontSize="14"
                           SemanticProperties.Description="Reenviar el código al correo">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResendCodeCommand}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CanResend}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource BrandTertiary}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Grid.Column="1"
                           Text="Cambiar correo"
                           HorizontalOptions="End"
                           Style="{StaticResource AuthLinkStyle}"
                           FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeEmailCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </VerticalStackLayout>

            <!-- ===== Paso 3: contraseña nueva ===== -->
            <VerticalStackLayout Margin="0,28,0,0" Spacing="0" IsVisible="{Binding IsPasswordStep}">
                <Border Style="{StaticResource AuthFieldBorderStyle}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" x:DataType="controls:BorderlessEntry"
                                     Binding="{Binding Source={x:Reference PasswordEntry}, Path=IsFocused}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource BrandSecondary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="ic_field_lock.png" Style="{StaticResource AuthFieldIconStyle}" />
                        <controls:BorderlessEntry x:Name="PasswordEntry"
                                                  Grid.Column="1"
                                                  Placeholder="Contraseña nueva"
                                                  Text="{Binding Password}"
                                                  IsPassword="{Binding IsPasswordHidden}"
                                                  IsSpellCheckEnabled="False"
                                                  IsTextPredictionEnabled="False"
                                                  ReturnType="Next"
                                                  Style="{StaticResource AuthEntryStyle}"
                                                  SemanticProperties.Description="Contraseña nueva" />
                        <ImageButton Grid.Column="2"
                                     Source="ic_eye.png"
                                     WidthRequest="44"
                                     HeightRequest="44"
                                     Padding="11"
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center"
                                     Command="{Binding TogglePasswordVisibilityCommand}"
                                     SemanticProperties.Description="Mostrar contraseña">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding IsPasswordHidden}" Value="False">
                                    <Setter Property="Source" Value="ic_eye_off.png" />
                                    <Setter Property="SemanticProperties.Description" Value="Ocultar contraseña" />
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </Grid>
                </Border>
                <Label Text="{Binding PasswordHint}" Style="{StaticResource FieldHintStyle}" />
                <Label Text="{Binding PasswordError}" Style="{StaticResource FieldErrorStyle}" />

                <Border Margin="0,14,0,0" Style="{StaticResource AuthFieldBorderStyle}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" x:DataType="controls:BorderlessEntry"
                                     Binding="{Binding Source={x:Reference PasswordConfirmationEntry}, Path=IsFocused}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource BrandSecondary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Source="ic_field_lock.png" Style="{StaticResource AuthFieldIconStyle}" />
                        <controls:BorderlessEntry x:Name="PasswordConfirmationEntry"
                                                  Grid.Column="1"
                                                  Placeholder="Confirmar contraseña"
                                                  Text="{Binding PasswordConfirmation}"
                                                  IsPassword="{Binding IsPasswordHidden}"
                                                  IsSpellCheckEnabled="False"
                                                  IsTextPredictionEnabled="False"
                                                  ReturnType="Done"
                                                  ReturnCommand="{Binding SavePasswordCommand}"
                                                  Style="{StaticResource AuthEntryStyle}"
                                                  SemanticProperties.Description="Confirmar contraseña" />
                    </Grid>
                </Border>
                <Label Text="{Binding PasswordConfirmationError}" Style="{StaticResource FieldErrorStyle}" />

                <Button Text="Guardar y entrar"
                        Margin="0,20,0,0"
                        Style="{StaticResource AuthPrimaryButtonStyle}"
                        Command="{Binding SavePasswordCommand}" />
            </VerticalStackLayout>

            <!-- ===== Estado ===== -->
            <ActivityIndicator Margin="0,16,0,0"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandCream}}" />
            <Label Text="{Binding ErrorMessage}"
                   Margin="0,8,0,0"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource FieldErrorStyle}"
                   FontSize="13" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
